      "id": "split",
      "title": "原文拆分",
      "cat": "数据整理",
      "use": "解释一份输入怎样拆成多个处理单元",
      "observe": "原文中的四段保持文字与颜色，依次移出",
      "limit": "切块不等于摘要，片段数量仅作示意",
      "bindings": [
        "items"
      ],
      "relation": "decomposition",
      "requiredFacts": [
        "inputCount",
        "outputCount"
      ],
      "videoAdapter": "MotionActions.add",
      "status": "callable-adapter-requires-shot-review",
      "exampleConfig": {
        "type": "split",
        "start": 0,
        "duration": 8,
        "bindings": {
          "items": [
            "#split-item0",
            "#split-item1",
            "#split-item2",
            "#split-item3"
          ]
        },
        "params": {
          "from": [
            [
              60,
              45
            ],
            [
              60,
              120
            ],
            [
              60,
              195
            ],
            [
              60,
              270
            ]
          ],
          "to": [
            [
              1100,
              45
            ],
            [
              1100,
              120
            ],
            [
              1100,
              195
            ],
            [
              1100,
              270
            ]
          ]
        }
      },
      "exampleFile": "examples/action-split.html"
    },
